# Supabase (Project Settings → API Keys). A chave publicável pode ir no app.
NEXT_PUBLIC_SUPABASE_URL=https://ztzmvdmggxyokfbakajq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Link da live no YouTube (opcional; sem ele a home usa a live de teste).
NEXT_PUBLIC_YOUTUBE_LIVE_URL=
# Endereço do mapa de rastreamento (opcional; sem ele a home usa o mapa publicado).
# Para o mapa local só no `npm run dev`, coloque em .env.development.local.
NEXT_PUBLIC_TRACKING_URL=
# Liga as notificações no app nativo depois que o Firebase estiver configurado.
NEXT_PUBLIC_PUSH_ENABLED=false
